# dsh-ltm-mcp installs only what it needs: @tr1v3r/dsh-ltm + its transitive
# @deepseek-ai/schemastery. The heavy DSH/Cordis peer deps are NOT required
# here because this bridge imports dsh-ltm's engine chunk directly rather than
# loading the Cordis plugin. Ignoring peers also keeps the install deterministic
# when the published peer versions do not satisfy dsh-ltm's declared ranges.
legacy-peer-deps=true
audit=false
fund=false
